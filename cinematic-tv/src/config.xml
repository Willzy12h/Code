<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/Willzy12h/cinematic-tv-launcher" version="0.5.1" viewmodes="maximized">
  <name>Cinematic TV</name>
  <description>Personal ad-free Samsung TV app launcher</description>
  <icon src="assets/icon-051.png"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:application id="CinemTV001.Launcher" package="CinemTV001" required_version="6.0"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" pointing-device-support="disable" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/package.info"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <access origin="https://api.open-meteo.com" subdomains="false"/>
  <access origin="https://geocoding-api.open-meteo.com" subdomains="false"/>
  <!-- Arbitrary HTTPS wallpaper images are opt-in. CSP limits executable/network request sources. -->
  <access origin="*" subdomains="true"/>
  <tizen:content-security-policy>default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: file: wgt: https:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.github.com https://commons.wikimedia.org https://upload.wikimedia.org https://thumb.wikimedia.org; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'</tizen:content-security-policy>
</widget>
